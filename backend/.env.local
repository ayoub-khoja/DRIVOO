# General
NODE_ENV=development

# Backend server
BC_PORT=4002
# Public URLs use HTTPS via reverse proxy; Node always serves HTTP (no local certs)
BC_HTTPS=false
# BC_PRIVATE_KEY / BC_CERTIFICATE removed — TLS is terminated by Nginx/OVH, not Node

# MongoDB
BC_DB_URI=mongodb://127.0.0.1:27017/bookcars?authSource=admin&appName=bookcars
BC_DB_SSL=false
# BC_DB_SSL_CERT=/etc/ssl/bookcars.crt
# BC_DB_SSL_CA=/etc/ssl/bookcars.ca.pem
BC_DB_DEBUG=false

# Auth
BC_COOKIE_SECRET=COOKIE_SECRET
BC_AUTH_COOKIE_DOMAIN=localhost
BC_ADMIN_HOST=http://localhost:3002/ # very important, otherwise admin auth won't work
BC_FRONTEND_HOST=http://localhost:3002/ # very important, otherwise frontend auth won't work
BC_JWT_SECRET=JWT_SECRET
BC_JWT_EXPIRE_AT=86400
BC_TOKEN_EXPIRE_AT=86400
BC_APPLE_CLIENT_ID_WEB=APPLE_CLIENT_ID_WEB
BC_APPLE_CLIENT_ID_MOBILE=APPLE_CLIENT_ID_MOBILE
BC_GOOGLE_CLIENT_ID=GOOGLE_CLIENT_ID
BC_GOOGLE_MOBILE_CLIENT_ID=GOOGLE_MOBILE_CLIENT_ID
BC_FACEBOOK_APP_ID=FACEBOOK_APP_ID
BC_FACEBOOK_APP_SECRET=FACEBOOK_APP_SECRET

# Email (SMTP) - OVH Zimbra contact@drivoo.net
BC_SMTP_HOST=ssl0.ovh.net
BC_SMTP_PORT=587
BC_SMTP_USER=contact@drivoo.net
BC_SMTP_PASS="Drivoo2026&"
BC_SMTP_FROM=contact@drivoo.net

# CDN (File storage)
BC_CDN_ROOT=C:/Users/ASUS/Desktop/bookcars/cdn
BC_CDN_USERS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/users
BC_CDN_TEMP_USERS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/users
BC_CDN_CARS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/cars
BC_CDN_TEMP_CARS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/cars
BC_CDN_LOCATIONS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/locations
BC_CDN_TEMP_LOCATIONS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/locations
BC_CDN_CONTRACTS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/contracts
BC_CDN_TEMP_CONTRACTS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/contracts
BC_CDN_LICENSES=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/licenses
BC_CDN_TEMP_LICENSES=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/licenses
BC_CDN_SUPPLIER_DOCS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/supplier-docs
BC_CDN_TEMP_SUPPLIER_DOCS=C:/Users/ASUS/Desktop/bookcars/cdn/bookcars/temp/supplier-docs

# Localization
BC_DEFAULT_LANGUAGE=en

# Business Rules
BC_MINIMUM_AGE=21

# Expo
BC_EXPO_ACCESS_TOKEN=EXPO_ACCESS_TOKEN

