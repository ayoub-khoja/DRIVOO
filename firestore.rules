rules_version = '2';

// Phase 1: Drivoo authenticates with its own JWT cookies, not Firebase Auth.
// The Admin SDK (backend) bypasses these rules. Client SDK access is denied
// until Custom Tokens are introduced for realtime chat.
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
